{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    // TypeScript 6 needs this listed explicitly; automatic @types inclusion no longer applies.
    // Mocha's globals belong to the integration tests only (tsconfig.test.json) — leaving them
    // here would let a vitest file that forgot its `import { describe } from 'vitest'` compile.
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true
  },
  "include": ["src", "test/unit", "vitest.config.mts"]
}
